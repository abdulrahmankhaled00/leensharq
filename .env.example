# Database: either one connection URL…
DATABASE_URL=
# …or the separate variables some hosts inject automatically (used when DATABASE_URL is empty).
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Dashboard login (plain text, easy to change). Set the same names in the host Secrets.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Session cookie secret: any long random text
SESSION_SECRET=
